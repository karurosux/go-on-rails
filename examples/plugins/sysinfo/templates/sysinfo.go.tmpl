// Package sysinfo exposes runtime information (generated by the sysinfo
// gor plugin for {{.AppName}}).
package sysinfo

import (
	"net/http"
	"os"
	"runtime"

	"github.com/labstack/echo/v4"
)

// Handler reports runtime details.
func Handler() echo.HandlerFunc {
	return func(c echo.Context) error {
		return c.JSON(http.StatusOK, map[string]string{
			"app":   "{{.AppName}}",
			"go":    runtime.Version(),
			"label": os.Getenv("SYSINFO_LABEL"),
		})
	}
}
