// Package storage saves uploaded files and serves/returns their URLs.
// Resources store the returned URL in a plain text column (field type
// `file`).
//
// Two drivers, chosen at runtime by STORAGE_DRIVER:
//   - "disk" (default): local directory, served at /uploads/* (disk.go)
//   - "s3": any S3-compatible store — AWS S3, Cloudflare R2, MinIO,
//     DigitalOcean Spaces (s3.go)
package storage

import (
	"context"
	"crypto/rand"
	"encoding/hex"
	"fmt"
	"io"
	"net/http"
	"os"
	"path/filepath"
	"regexp"
	"strings"

	"github.com/labstack/echo/v4"
)

// Upload is the response for a stored file.
type Upload struct {
	URL         string `json:"url"`
	Filename    string `json:"filename"`
	ContentType string `json:"contentType"`
	Size        int64  `json:"size"`
}

var extRe = regexp.MustCompile(`^\.[a-z0-9]{1,8}$`)

// newKey returns a random object key, keeping a sanitized extension.
func newKey(filename string) (string, error) {
	ext := strings.ToLower(filepath.Ext(filename))
	if !extRe.MatchString(ext) {
		ext = ""
	}
	b := make([]byte, 16)
	if _, err := rand.Read(b); err != nil {
		return "", err
	}
	return hex.EncodeToString(b) + ext, nil
}

// Save streams r to the configured driver and returns the public URL.
// size may be -1 when unknown.
func Save(ctx context.Context, filename, contentType string, r io.Reader, size int64) (Upload, error) {
	key, err := newKey(filename)
	if err != nil {
		return Upload{}, err
	}
	switch driver := os.Getenv("STORAGE_DRIVER"); driver {
	case "", "disk":
		return diskSave(key, filename, contentType, r)
	case "s3":
		return s3Save(ctx, key, filename, contentType, r, size)
	default:
		return Upload{}, fmt.Errorf("unknown STORAGE_DRIVER %q (want disk or s3)", driver)
	}
}

// Handler accepts a multipart "file" field (POST /api/uploads) and stores it.
func Handler() echo.HandlerFunc {
	return func(c echo.Context) error {
		fileHeader, err := c.FormFile("file")
		if err != nil {
			return echo.NewHTTPError(http.StatusBadRequest, `multipart "file" field is required`)
		}
		src, err := fileHeader.Open()
		if err != nil {
			return fmt.Errorf("open upload: %w", err)
		}
		defer src.Close()

		upload, err := Save(c.Request().Context(), fileHeader.Filename,
			fileHeader.Header.Get("Content-Type"), src, fileHeader.Size)
		if err != nil {
			return err
		}
		return c.JSON(http.StatusCreated, upload)
	}
}
