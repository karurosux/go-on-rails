# Build the production image: frontend build -> Go build -> minimal runtime.
# Build:  gor build --image   (or: docker build -t {{.AppName}} .)
# Run:    docker run -p 8080:8080 -e DATABASE_URL=postgres://... {{.AppName}}

# --- frontend build ---
FROM node:{{.NodeMajor}}-alpine AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY web/ ./
RUN npm run build

# --- backend build ---
FROM golang:1-alpine AS build
# Download a newer Go toolchain automatically if go.mod requires one.
ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /app/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /{{.AppName}} ./cmd/server
# gor:docker-build

# --- runtime ---
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /{{.AppName}} /{{.AppName}}
# gor:docker-copy
ENV APP_ENV=production
EXPOSE 8080
ENTRYPOINT ["/{{.AppName}}"]
