// Seed fills the development database with starter data.
// Run it with: gor db seed
package main

import (
	"context"
	"log/slog"
	"os"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/db"
	dbgen "{{.Module}}/internal/db/gen"
)

func main() {
	cfg, err := config.Load()
	if err != nil {
		slog.Error("invalid configuration", "error", err)
		os.Exit(1)
	}
	ctx := context.Background()
	pool, err := db.Connect(ctx, cfg.DatabaseURL)
	if err != nil {
		slog.Error("database connection failed", "error", err)
		os.Exit(1)
	}
	defer pool.Close()
	queries := dbgen.New(pool)

	// Seed your data here. Seeds should be idempotent — safe to run twice.
	// Example:
	//
	//	post, err := queries.CreatePost(ctx, dbgen.CreatePostParams{
	//		Title: "Hello gor",
	//		Body:  "Seeded content",
	//	})
	_ = queries

	slog.Info("database seeded")
}
