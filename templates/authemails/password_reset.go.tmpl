package mailer

import "context"

// PasswordResetData fills the password reset email.
type PasswordResetData struct {
	Link string
}

// SendPasswordReset emails a password reset link (valid for one hour).
func SendPasswordReset(ctx context.Context, to string, data PasswordResetData) error {
	return Send(ctx, to, "Reset your password", "password_reset", data)
}
