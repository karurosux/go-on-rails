import { useState } from "react";
import { Link } from "react-router";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { useForgotPassword } from "../../api/account";

export function ForgotPasswordPage() {
  const [email, setEmail] = useState("");
  const forgot = useForgotPassword();

  if (forgot.isSuccess) {
    return (
      <div className="mx-auto max-w-sm text-center">
        <h1 className="mb-3 text-2xl font-semibold">Check your inbox</h1>
        <p className="text-muted-foreground">
          If an account exists for {email}, we sent a password reset link.
        </p>
        <Button asChild variant="link" className="mt-4">
          <Link to="/login">Back to sign in</Link>
        </Button>
      </div>
    );
  }

  return (
    <div className="mx-auto max-w-sm">
      <h1 className="mb-6 text-2xl font-semibold">Forgot password</h1>
      <form
        onSubmit={(event) => {
          event.preventDefault();
          forgot.mutate(email);
        }}
        className="space-y-5"
      >
        <div className="space-y-2">
          <Label htmlFor="email">Email</Label>
          <Input
            id="email"
            type="email"
            autoComplete="email"
            required
            value={email}
            onChange={(event) => setEmail(event.target.value)}
          />
        </div>
        <Button type="submit" disabled={forgot.isPending} className="w-full">
          Send reset link
        </Button>
      </form>
    </div>
  );
}
