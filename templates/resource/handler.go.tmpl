func (h *Handler) Get(c echo.Context) error {
	id, err := uuid.Parse(c.Param("id"))
	if err != nil {
		return echo.NewHTTPError(http.StatusBadRequest, "invalid id")
	}
{{if .Service}}	item, err := h.svc.Get(c.Request().Context(), id)
{{else}}	item, err := h.q.Get{{.Pascal}}(c.Request().Context(), id)
{{end}}	if errors.Is(err, pgx.ErrNoRows) {
		return echo.NewHTTPError(http.StatusNotFound, "{{.HumanLower}} not found")
	}
	if err != nil {
		return err
	}
	return c.JSON(http.StatusOK, item)
}

