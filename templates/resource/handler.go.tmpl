// List handles GET /api/{{.Plural}}?page=1&perPage=25&sort=newest{{if .HasSearch}}&search=...{{end}}.
func (h *Handler) List(c echo.Context) error {
	page, _ := strconv.Atoi(c.QueryParam("page"))
	if page < 1 {
		page = 1
	}
	perPage, _ := strconv.Atoi(c.QueryParam("perPage"))
	if perPage < 1 || perPage > 100 {
		perPage = 25
	}
	oldest := c.QueryParam("sort") == "oldest"
{{- if .HasSearch}}
	search := c.QueryParam("search")
{{- end}}

	ctx := c.Request().Context()
{{if .Service}}	items, total, err := h.svc.List(ctx, {{if .HasSearch}}search{{else}}""{{end}}, oldest, int32(perPage), int32((page-1)*perPage))
	if err != nil {
		return err
	}
{{else}}	items, err := h.q.List{{.PluralPascal}}(ctx, dbgen.List{{.PluralPascal}}Params{
{{- if .HasSearch}}
		Search: search,
{{- end}}
		Oldest:    oldest,
		RowLimit:  int32(perPage),
		RowOffset: int32((page - 1) * perPage),
	})
	if err != nil {
		return err
	}
	total, err := h.q.Count{{.PluralPascal}}(ctx{{if .HasSearch}}, search{{end}})
	if err != nil {
		return err
	}
{{end}}	if items == nil {
		items = []dbgen.{{.Pascal}}{}
	}
	return c.JSON(http.StatusOK, listResponse{
		Data: items,
		Meta: listMeta{Page: page, PerPage: perPage, Total: total},
	})
}

