import { useState } from "react";
import { Link } from "react-router";
{{- if .Live}}
import { useRealtimeInvalidate } from "@/lib/realtime";
{{- end}}
import { Button } from "@/components/ui/button";
{{- if .HasSearch}}
import { Input } from "@/components/ui/input";
{{- end}}
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  use{{.PluralPascal}},
  useDelete{{.Pascal}},
  type {{.Pascal}}Sort,
} from "../../api/{{.Plural}}";

export function {{.PluralPascal}}List() {
  const [page, setPage] = useState(1);
{{- if .HasSearch}}
  const [search, setSearch] = useState("");
{{- end}}
  const [sort, setSort] = useState<{{.Pascal}}Sort>("newest");
  const { data, isLoading, isError, error } = use{{.PluralPascal}}(page, {{if .HasSearch}}search{{else}}""{{end}}, sort);
  const deleteMutation = useDelete{{.Pascal}}();
{{- if .Live}}
  useRealtimeInvalidate("{{.Plural}}", ["{{.Plural}}"]); // live updates across browsers
{{- end}}

  if (isLoading) return <p className="text-muted-foreground">Loading…</p>;
  if (isError) return <p className="text-destructive">{error.message}</p>;
  if (!data) return null;

  const { data: items, meta } = data;
  const totalPages = Math.max(1, Math.ceil(meta.total / meta.perPage));

  return (
    <div>
      <div className="mb-6 flex items-center justify-between">
        <h1 className="text-2xl font-semibold">{{.PluralHuman}}</h1>
        <Button asChild>
          <Link to="/{{.Plural}}/new">New {{.HumanLower}}</Link>
        </Button>
      </div>

      <div className="mb-4 flex items-center gap-3">
{{- if .HasSearch}}
        <Input
          type="search"
          placeholder="Search {{.PluralHumanLower}}…"
          value={search}
          onChange={(event) => {
            setSearch(event.target.value);
            setPage(1);
          }}
          className="max-w-xs"
        />
{{- end}}
        <select
          value={sort}
          onChange={(event) => {
            setSort(event.target.value as {{.Pascal}}Sort);
            setPage(1);
          }}
          className="h-9 rounded-md border border-input bg-transparent px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
        >
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>

      {items.length === 0 ? (
        <p className="rounded-lg border border-dashed p-8 text-center text-muted-foreground">
          {{if .HasSearch}}{search ? "No matches." : "No {{.PluralHumanLower}} yet. Create the first one!"}{{else}}No {{.PluralHumanLower}} yet. Create the first one!{{end}}
        </p>
      ) : (
        <Table>
          <TableHeader>
            <TableRow>
{{- range .Fields}}
              <TableHead>{{.Label}}</TableHead>
{{- end}}
              <TableHead />
            </TableRow>
          </TableHeader>
          <TableBody>
            {items.map((item) => (
              <TableRow key={item.id}>
{{- range .Fields}}
                <TableCell className="max-w-xs truncate">{{.CellExpr}}</TableCell>
{{- end}}
                <TableCell className="text-right">
                  <Button asChild variant="ghost" size="sm">
                    <Link to={`/{{.Plural}}/${item.id}`}>View</Link>
                  </Button>
                  <Button asChild variant="ghost" size="sm">
                    <Link to={`/{{.Plural}}/${item.id}/edit`}>Edit</Link>
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    className="text-destructive hover:text-destructive"
                    onClick={() => {
                      if (confirm("Delete this {{.HumanLower}}?")) deleteMutation.mutate(item.id);
                    }}
                  >
                    Delete
                  </Button>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}

      {totalPages > 1 && (
        <div className="mt-6 flex items-center justify-center gap-4 text-sm">
          <Button
            variant="outline"
            size="sm"
            disabled={page <= 1}
            onClick={() => setPage((p) => p - 1)}
          >
            Previous
          </Button>
          <span className="text-muted-foreground">
            Page {page} of {totalPages}
          </span>
          <Button
            variant="outline"
            size="sm"
            disabled={page >= totalPages}
            onClick={() => setPage((p) => p + 1)}
          >
            Next
          </Button>
        </div>
      )}
    </div>
  );
}
