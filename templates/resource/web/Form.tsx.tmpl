import { useEffect } from "react";
import { {{if .HasBool}}Controller, {{end}}useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { Link, useNavigate, useParams } from "react-router";
import { Button } from "@/components/ui/button";
{{- if .HasBool}}
import { Checkbox } from "@/components/ui/checkbox";
{{- end}}
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
{{- if .HasTextarea}}
import { Textarea } from "@/components/ui/textarea";
{{- end}}
import { ApiError } from "../../api/client";
import {
  use{{.Pascal}},
  useCreate{{.Pascal}},
  useUpdate{{.Pascal}},
  type {{.Pascal}}Input,
} from "../../api/{{.Plural}}";
import { {{.Camel}}Schema, type {{.Pascal}}FormValues } from "./schema";

export function {{.Pascal}}Form() {
  const { id } = useParams();
  const isEdit = id !== undefined;
  const navigate = useNavigate();
  const existing = use{{.Pascal}}(id ?? "");
  const createMutation = useCreate{{.Pascal}}();
  const updateMutation = useUpdate{{.Pascal}}();

  const {
    register,
{{- if .HasBool}}
    control,
{{- end}}
    handleSubmit,
    reset,
    setError,
    formState: { errors, isSubmitting },
  } = useForm<{{.Pascal}}FormValues>({
    resolver: zodResolver({{.Camel}}Schema),
    defaultValues: {
{{- range .Fields}}
      {{.TSName}}: {{.DefaultTS}},
{{- end}}
    },
  });

  useEffect(() => {
    if (existing.data) {
      reset({
{{- range .Fields}}
        {{.TSName}}: {{.EditExpr}},
{{- end}}
      });
    }
  }, [existing.data, reset]);

  async function onSubmit(values: {{.Pascal}}FormValues) {
    const input: {{.Pascal}}Input = {
{{- range .Fields}}
      {{.TSName}}: {{.SubmitExpr}},
{{- end}}
    };
    try {
      if (isEdit) {
        await updateMutation.mutateAsync({ id, input });
        navigate(`/{{.Plural}}/${id}`);
      } else {
        const created = await createMutation.mutateAsync(input);
        navigate(`/{{.Plural}}/${created.id}`);
      }
    } catch (err) {
      if (err instanceof ApiError && err.fields) {
        for (const [field, message] of Object.entries(err.fields)) {
          setError(field as keyof {{.Pascal}}FormValues, { message });
        }
      } else {
        setError("root", {
          message: err instanceof Error ? err.message : "Something went wrong",
        });
      }
    }
  }

  if (isEdit && existing.isLoading) return <p className="text-muted-foreground">Loading…</p>;
  if (isEdit && existing.isError)
    return <p className="text-destructive">{existing.error.message}</p>;

  return (
    <div className="mx-auto max-w-xl">
      <h1 className="mb-6 text-2xl font-semibold">
        {isEdit ? "Edit {{.HumanLower}}" : "New {{.HumanLower}}"}
      </h1>

      <form onSubmit={handleSubmit(onSubmit)} className="space-y-5" noValidate>
{{- range .Fields}}
{{- if eq .Input "checkbox"}}
        <div className="flex items-center gap-2">
          <Controller
            control={control}
            name="{{.TSName}}"
            render={({ field }) => (
              <Checkbox
                id="{{.TSName}}"
                checked={field.value}
                onCheckedChange={field.onChange}
              />
            )}
          />
          <Label htmlFor="{{.TSName}}">{{.Label}}</Label>
          {errors.{{.TSName}} && (
            <p className="text-sm text-destructive">{errors.{{.TSName}}.message}</p>
          )}
        </div>
{{- else}}
        <div className="space-y-2">
          <Label htmlFor="{{.TSName}}">{{.Label}}</Label>
{{- if eq .Input "textarea"}}
          <Textarea id="{{.TSName}}" rows={5} {...register("{{.TSName}}")} />
{{- else if eq .Input "number"}}
          <Input id="{{.TSName}}" type="number" {...register("{{.TSName}}", { valueAsNumber: true })} />
{{- else if eq .Input "datetime-local"}}
          <Input id="{{.TSName}}" type="datetime-local" {...register("{{.TSName}}")} />
{{- else}}
          <Input id="{{.TSName}}" type="text" {...register("{{.TSName}}")} />
{{- end}}
          {errors.{{.TSName}} && (
            <p className="text-sm text-destructive">{errors.{{.TSName}}.message}</p>
          )}
        </div>
{{- end}}
{{- end}}

        {errors.root && <p className="text-sm text-destructive">{errors.root.message}</p>}

        <div className="flex gap-3 pt-2">
          <Button type="submit" disabled={isSubmitting}>
            {isEdit ? "Save changes" : "Create {{.HumanLower}}"}
          </Button>
          <Button asChild variant="outline">
            <Link to="/{{.Plural}}">Cancel</Link>
          </Button>
        </div>
      </form>
    </div>
  );
}
