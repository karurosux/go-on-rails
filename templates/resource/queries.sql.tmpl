-- name: List{{.PluralPascal}} :many
SELECT * FROM {{.Table}}
{{- if .HasSearch}}
WHERE (sqlc.arg('search')::text = ''{{range .SearchCols}} OR {{.}} ILIKE '%' || sqlc.arg('search') || '%'{{end}})
{{- end}}
ORDER BY
    CASE WHEN sqlc.arg('oldest')::boolean THEN created_at END ASC,
    created_at DESC
LIMIT sqlc.arg('row_limit')::int OFFSET sqlc.arg('row_offset')::int;

-- name: Count{{.PluralPascal}} :one
SELECT count(*) FROM {{.Table}}{{if .HasSearch}}
WHERE (sqlc.arg('search')::text = ''{{range .SearchCols}} OR {{.}} ILIKE '%' || sqlc.arg('search') || '%'{{end}}){{end}};

-- name: Get{{.Pascal}} :one
SELECT * FROM {{.Table}}
WHERE id = $1;

-- name: Create{{.Pascal}} :one
INSERT INTO {{.Table}} ({{.CreateCols}})
VALUES ({{.CreatePlaceholders}})
RETURNING *;

-- name: Update{{.Pascal}} :one
UPDATE {{.Table}} SET
{{- range .Fields}}
    {{.Column}} = coalesce(sqlc.narg('{{.Column}}'), {{.Column}}),
{{- end}}
    updated_at = now()
WHERE id = sqlc.arg('id')
RETURNING *;

-- name: Delete{{.Pascal}} :execrows
DELETE FROM {{.Table}}
WHERE id = $1;
